<?xml version="1.0" encoding="utf-8"?>
<Defs>
      <!-- Unique Archotech Charge Rifle -->
      <ThingDef ParentName="Gun_ArchotechChargeRifle">
        <defName>Gun_ArchotechChargeRifle_Unique</defName>
        <label>unique archotech charge rifle</label>
        <description>An archotech charge rifle with customized parts.</description>
        <graphicData>
          <texPath>Things/Weapons/ArchoRifle</texPath>
          <graphicClass>Graphic_Single</graphicClass>
          <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <comps Inherit="False">
          <li Class="CompProperties_EquippableAbilityReloadable" />
          <li Class="CompProperties_Forbiddable"/>
          <li Class="CompProperties_Styleable"/>
          <li Class="CompProperties_Biocodable"/>
          <li>
            <compClass>CompQuality</compClass>
          </li>
          <li Class="CompProperties_Art">
            <nameMaker>NamerArtWeaponGun</nameMaker>
            <descriptionMaker>ArtDescription_WeaponGun</descriptionMaker>
            <minQualityForArtistic>Excellent</minQualityForArtistic>
          </li>
          <li Class="CompProperties_UniqueWeapon">
            <weaponCategories>
              <li>Ranged</li>
              <li>BulletFiring</li>
              <li>Gun</li>
              <li>BurstFire</li>
              <li>Rifle</li>
              <li>Sighted</li>
              <li>Attachable</li>
            </weaponCategories>
            <namerLabels>
              <li>Archotech rifle</li>
              <li>Starfall</li>
              <li>Ol Reliable</li>
              <li>Shine</li>
              <li>Void rifle</li>
              <li>Celestial lance</li>
              <li>Marvel of engineering</li>
            </namerLabels>
          </li>
        </comps>
        <generateAllowChance>0</generateAllowChance>
        <possessionCount>0</possessionCount>
        <tradeability>All</tradeability>
        <thingSetMakerTags Inherit="False">
          <li>RewardStandardLowFreq</li>
          <li>UniqueWeapon</li>
        </thingSetMakerTags>
        <recipeMaker Inherit="False" IsNull="True" />
        <thingCategories Inherit="False">
          <li>WeaponsUnique</li>
        </thingCategories>
        <descriptionHyperlinks>
          <ThingDef>Gun_ArchotechChargeRifle</ThingDef>
        </descriptionHyperlinks>
      </ThingDef>

