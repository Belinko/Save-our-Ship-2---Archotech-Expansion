            </li>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Gun_ArchotechRevolver_Unique"]/comps</xpath>
          <value>
            <li Class="CombatExtended.CompProperties_AmmoUser">
              <magazineSize>6</magazineSize>
              <reloadTime>3</reloadTime>
