<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Odyssey</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Normal</success>
      <operations>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Gun_ArchotechChargeRifle_Unique"]/comps</xpath>
          <value>
            <li Class="CombatExtended.CompProperties_AmmoUser">
              <magazineSize>30</magazineSize>
              <reloadTime>4</reloadTime>
            </li>
            <li Class="CombatExtended.CompProperties_FireModes">
              <aiAimMode>AimedShot</aiAimMode>
              <aimedBurstShotCount>4</aimedBurstShotCount>
            </li>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="Gun_ArchotechChargeRifle_Unique"]/comps/li[@Class="CompProperties_EquippableAbilityReloadable"]</xpath>
          <value>
            <li Class="CombatExtended.CompProperties_UnderBarrel" />
            <li>
              <compClass>CompEquippable</compClass>
            </li>
          </value>
        </li>

        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Gun_ArchotechChargeSMG_Unique"]/comps</xpath>
          <value>
            <li Class="CombatExtended.CompProperties_AmmoUser">
              <magazineSize>40</magazineSize>
              <reloadTime>4</reloadTime>
            </li>
            <li Class="CombatExtended.CompProperties_FireModes">
