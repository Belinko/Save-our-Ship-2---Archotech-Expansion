	<Operation Class="PatchOperationReplace">
		<xpath>/Defs/ThingDef[defName='ShipTurret_ArchoHeavyGunLaser']/verbs</xpath>
		<value>
			<verbs>
				<li Class="CombatExtended.Compatibility.SOS2Compat.VerbPropertiesShipWeaponCE">
