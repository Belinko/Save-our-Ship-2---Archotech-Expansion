		<building>
			<isAirtight>true</isAirtight>
			<shipPart>true</shipPart>
			<paintable>true</paintable>
		</building>
		<costList>
			<Steel>50</Steel>
			<Plasteel>10</Plasteel>
			<ComponentIndustrial>3</ComponentIndustrial>
		</costList>
	</ThingDef>
	<!-- scaners -->
	<ThingDef ParentName="BuildingShipBase">
		<defName>ArchotechShip_SensorClusterAdv</defName>
		<label>Archotech advanced sensors</label>
		<designatorDropdown>Ship_Sensors</designatorDropdown>
		<thingClass>SaveOurShip2.Building_ShipSensor</thingClass>
		<graphicData>
			<texPath>Things/Building/Ship/ArchoSencsors</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(3,3)</drawSize>
		</graphicData>
		<researchPrerequisites>
			<li>ArchotechScanners</li>
		</researchPrerequisites>
		<statBases>
			<WorkToBuild>65000</WorkToBuild>
			<MaxHitPoints>2000</MaxHitPoints>
			<Flammability>0</Flammability>
		</statBases>
		<tickerType>Normal</tickerType>
		<description>Archotech ship sensors. Automatically scans for nearby sites of interest. They are much faster than any other moddrs ship sensors.</description>
		<size>(3,3)</size>
		<designationCategory>Ship</designationCategory>
		<comps>
			<li Class="SaveOurShip2.CompProps_ShipCachePart"/>
			<li Class="SaveOurShip2.CompProps_ShipScannerAI">
				<mtbDays>5</mtbDays>
			</li>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>850</basePowerConsumption>
				<transmitsPower>true</transmitsPower>
			</li>
			<li Class="CompProperties_Flickable"/>
		</comps>
		<rotatable>false</rotatable>
		<costList>
			<Steel>550</Steel>
			<Gold>25</Gold>
			<ComponentSpacer>15</ComponentSpacer>
			<ArchotechExoticParticles>5</ArchotechExoticParticles>
		</costList>
		<placeWorkers>
			<li>SaveOurShip2.PlaceWorker_OnShipHull</li>
		</placeWorkers>
		<designationHotKey>Misc5</designationHotKey>
		<constructionSkillPrerequisite>12</constructionSkillPrerequisite>
		<building>
			<isAirtight>true</isAirtight>
		</building>
	</ThingDef>





