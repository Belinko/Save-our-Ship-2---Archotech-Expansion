            <researchPrerequisites>
                <li>ArchotechHeatsink</li>
            </researchPrerequisites>
     </ThingDef>
     <!-- shield -->
     <ThingDef ParentName="BuildingBase">
			<defName>AncientArchotechShield</defName>
			<label>Archotech shield generator</label>
			<designatorDropdown>Ship_Shields</designatorDropdown>
			<description>A charged up archotech shields, now in their true form. Its nothing than anything you have ever seen before.</description>
			<size>(3,3)</size>
			<receivesSignals>true</receivesSignals>
			<statBases>
				<MaxHitPoints>1000</MaxHitPoints>
				<Flammability>0.5</Flammability>
				<WorkToBuild>10000</WorkToBuild>
			</statBases>
			<graphicData>
				<texPath>Things/Building/Ship/CHArchoShieldGen</texPath>
				<graphicClass>SaveOurShip2.Graphic_SingleOnOff</graphicClass>
				<drawSize>(3,3)</drawSize>
				<shadowData>
					<volume>(2.6, 0.8, 2.6)</volume>
				</shadowData>
				<damageData>
					<rect>(0.2, 0.2, 2.8, 2.8)</rect>
				</damageData>
			</graphicData>
			<drawerType>MapMeshAndRealTime</drawerType>
			<placeWorkers>
				<li>SaveOurShip2.PlaceWorker_ShipShieldRadius</li>
				<li>SaveOurShip2.PlaceWorker_OnShipHull</li>
			</placeWorkers>
			<comps>
				
				<li Class="SaveOurShip2.CompProps_ShipHeat">
					<compClass>SaveOurShip2.CompShipHeatShield</compClass>
					<heatMultiplier>0.70</heatMultiplier>
					<color>(0,255,0)</color>
				</li>
				<li Class="CompProperties_Power">
					<compClass>CompPowerTrader</compClass>
					<basePowerConsumption>2000</basePowerConsumption>
					<transmitsPower>true</transmitsPower>
				</li>
                <li Class="CompProperties_Glower">
				<glowRadius>6</glowRadius>
				    <glowColor>(0,255,0,0)</glowColor>
				    <colorPickerEnabled>false</colorPickerEnabled>
			    </li>
				<li Class="CompProperties_Flickable"/>
				<li Class="CompProperties_Breakdownable"/>
			</comps>
			<rotatable>false</rotatable>
			<selectable>true</selectable>
			<soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
			<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
			<designationCategory>Ship</designationCategory>
			<constructEffect>ConstructMetal</constructEffect>
			<tickerType>Normal</tickerType>
			<researchPrerequisites>
				<li>ArchotechShields</li>
			</researchPrerequisites>
			<costList>
				<Plasteel>500</Plasteel>
				<Gold>50</Gold>
				<Silver>1000</Silver>
				<ComponentSpacer>10</ComponentSpacer>
				<ArchotechExoticParticles>7</ArchotechExoticParticles>
			</costList>
			<seeThroughFog>true</seeThroughFog>
			<modExtensions>
				<li Class = "Vehicles.CustomCostDefModExtension">
					<cost>10000</cost>
				</li>
			</modExtensions>
		</ThingDef>
       <!-- Big engine -->
		<ThingDef ParentName="BuildingShipBase">
		<defName>ArchoBigEngine</defName>
		<label>Archotech Nuclear Engine</label>
		<designatorDropdown>Ship_Engines</designatorDropdown>
		<thingClass>Building</thingClass>
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			<texPath>Things/Building/Ship/ArchoBigEngine</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(5,7)</drawSize>
		</graphicData>
		<altitudeLayer>BuildingOnTop</altitudeLayer>
		<researchPrerequisites>
			<li>ArchotechEngine</li>
		</researchPrerequisites>
		<statBases>
			<WorkToBuild>45000</WorkToBuild>
			<MaxHitPoints>5000</MaxHitPoints>
			<Flammability>0</Flammability>
		</statBases>
		<tickerType>Normal</tickerType>
		<description>A bigger and stronger vrsion of antimatter thruster, its nothing like you have ever seen before. Since it is based on known Nuclear Engines, it can be used for ship planet movement.</description>
		<size>(5,5)</size>
		<receivesSignals>true</receivesSignals>
		<designationCategory>Ship</designationCategory>
		<comps>
			<li Class="SaveOurShip2.CompProps_ShipCachePart">
				<hermetic>true</hermetic>
			</li>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>1500</basePowerConsumption>
				<transmitsPower>true</transmitsPower>
			</li>
			<li Class="CompProperties_Flickable"/>
			<li Class="SaveOurShip2.CompProps_RCSThruster"/>
			<li Class="CompProperties_Refuelable">
				<fuelCapacity>20000</fuelCapacity>
				<targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
				<fuelFilter>
					<thingDefs>
						<li>ShuttleFuelPods</li>
					</thingDefs>
				</fuelFilter>
				<consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
				<autoRefuelPercent>0.9</autoRefuelPercent>
				<showFuelGizmo>false</showFuelGizmo>
				<drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
				<drawFuelGaugeInMap>false</drawFuelGaugeInMap>
				<showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
			</li>
			<li Class="SaveOurShip2.CompProps_EngineTrail">
				<thrust>18</thrust>
				<fuelUse>2</fuelUse>
				<takeOff>true</takeOff>
			</li>
			<li Class="CompProperties_Glower">
				<glowRadius>7</glowRadius>
				<glowColor>(55,255,0,0)</glowColor>
				<colorPickerEnabled>false</colorPickerEnabled>
			</li>
		</comps>
		<placeWorkers>
			<li>SaveOurShip2.PlaceWorker_ShipEngine</li>
		</placeWorkers>
		<building>
			<isAirtight>true</isAirtight>
			<shipPart>true</shipPart>
		</building>
		<costList>
			<Steel>1000</Steel>
			<Plasteel>300</Plasteel>
			<Gold>15</Gold>
			<Uranium>35</Uranium>
			<ComponentSpacer>9</ComponentSpacer>
			<ArchotechExoticParticles>3</ArchotechExoticParticles>
		</costList>
		<designationHotKey>Misc5</designationHotKey>
	</ThingDef>
	<!-- turnTrusters -->
	<ThingDef ParentName="BuildingShipBase">
		<defName>ArchoShip_Thruster</defName>
		<label>Archotech RCS thruster</label>
		<designatorDropdown>Ship_Engines</designatorDropdown>
