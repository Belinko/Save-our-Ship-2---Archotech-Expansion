<?xml version="1.0" encoding="utf-8"?>
<Defs>
<!-- Cooler tank -->
    <ThingDef ParentName="ShipHeatsinkBase">
            <defName>Ship_SuperHeatArcho</defName>
            <label>Archotech Cooler tank</label>
            <holdsRoof>true</holdsRoof>
            <altitudeLayer>Gas</altitudeLayer>
            <description>Looks and works like a cooler tank, but its a heatsink at the same time? Not as eefective as actual heatsink, but its a good small bonus. \n\nHeat capacity: 16,000Hu\nHeat vented to space: 10/s\nHeat loss 5Hu/s</description>
            <size>(4,4)</size>
            <graphicData>
                <texPath>Things/Building/Ship/ArchoHeatCapacity</texPath>
                <graphicClass>Graphic_Single</graphicClass>
                <drawSize>(4,4)</drawSize>
            </graphicData>
            <statBases>
                <MaxHitPoints>2600</MaxHitPoints>
                <WorkToBuild>15000</WorkToBuild>
                <Flammability>0</Flammability>
                <Beauty>0</Beauty>
            </statBases>
            <passability>Impassable</passability>
            <seeThroughFog>true</seeThroughFog>
            <costList>
                <Steel>2000</Steel>
                <Plasteel>600</Plasteel>
                <Silver>600</Silver>
                <ComponentIndustrial>25</ComponentIndustrial>
                <ComponentSpacer>15</ComponentSpacer>
                <ArchotechExoticParticles>5</ArchotechExoticParticles>
            </costList>
            <comps>
                <li Class="SaveOurShip2.CompProps_ShipHeat">
                    <compClass>SaveOurShip2.CompShipHeatSink</compClass>
                    <showOnRoof>true</showOnRoof>
                    <heatCapacity>16000</heatCapacity>
                    <heatVent>10</heatVent>
                    <heatLoss>5</heatLoss>
                    <threat>20</threat>
                </li>
                <li Class="CompProperties_Power">
                    <compClass>CompPowerTransmitter</compClass>
                    <transmitsPower>true</transmitsPower>
                </li>
                <li>
                    <compClass>CompColorable</compClass>
                </li>
            </comps>
            <building>
                <paintable>true</paintable>
            </building>
            <researchPrerequisites>
                <li>ArchotechHeatsink</li>
            </researchPrerequisites>
     </ThingDef>

	 <!-- actual heatsink -->
