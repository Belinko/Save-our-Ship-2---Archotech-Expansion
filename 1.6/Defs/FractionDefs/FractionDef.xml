<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <FactionDef ParentName="AncientsBase">
    <defName>ArchotechFanaticsFrac</defName>
    <label>Ancients: Archotech Fanatics</label>
    <description>Elite Sanguophages and Ancients who take Archotechs as their father and god, they are hunting for any archotech technology and tend to believe that they are super humans.</description>
    <techLevel>Archotech</techLevel>
    <hidden>true</hidden>
    <permanentEnemy>true</permanentEnemy>
    <raidsForbidden>true</raidsForbidden>
    <raidCommonalityFromPointsCurve>
      <points>
        <li>(300, 0)</li>
        <li>(700, 1)</li>
        <li>(1400, 1.8)</li>
        <li>(2800, 2.2)</li>
        <li>(4000, 2.6)</li>
      </points>
    </raidCommonalityFromPointsCurve>
    
    <raidLootValueFromPointsCurve>
      <points>
        <li>(35, 8)</li>
        <li>(100, 60)</li>
        <li>(1000, 250)</li>
        <li>(2000, 400)</li>
        <li>(4000, 500)</li>
      </points>
    </raidLootValueFromPointsCurve>
    
  <pawnGroupMakers>
  <li>
    <kindDef>Combat</kindDef>
    <commonality>100</commonality>
    <options>
      <sanguophageFanaticsMelee>1</sanguophageFanaticsMelee>
    </options>
  </li>
  <li>
    <kindDef>Combat</kindDef>
    <commonality>100</commonality>
    <options>
      <sanguophageFanaticsGun>1</sanguophageFanaticsGun>
    </options>
  </li>
  <li>
    <kindDef>Combat</kindDef>
    <commonality>50</commonality>
    <options>
      <sanguophageFanaticsDemo>1</sanguophageFanaticsDemo>
    </options>
  </li>
</pawnGroupMakers>
    
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(500, 500)</li>     
        <li>(1000, 1000)</li>    
        <li>(10000, 5000)</li>   
      </points>
    </maxPawnCostPerTotalPointsCurve>
    
  
    <colorSpectrum>
      <li>(47, 255, 0)</li>    
      <li>(64, 242, 24)</li> 
    </colorSpectrum>
    <backstoryFilters>
      <li>
        <categories>
          <li>Offworld</li>
          <li>Spacer</li>
          <li>Archotech</li>
        </categories>
      </li>
    </backstoryFilters>
  </FactionDef>



<FactionDef ParentName="FactionBase" Abstract="True" Name="ArchotechMerchant">
    <pawnSingular>ArchotechMerchant</pawnSingular>
    <pawnsPlural>Archotech trader</pawnsPlural>
    <categoryTag>Archotech trader</categoryTag>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>2000</configurationListOrderPriority>
    <displayInFactionSelection>false</displayInFactionSelection>
    <fixedName>Archotech Merchant</fixedName>
    <canGenerateQuestSites>false</canGenerateQuestSites>
    <factionIconPath>World/WorldObjects/Expanding/Sites/DownedRefugee</factionIconPath>
    <techLevel>Spacer</techLevel>
    <backstoryFilters>
      <li>
        <categories>
          <li>Offworld</li>
          <li>Spacer</li>
        </categories>
      </li>
    </backstoryFilters>
    <hidden>true</hidden>
    <rescueesCanJoin>true</rescueesCanJoin>
    <autoFlee>false</autoFlee>
    <apparelStuffFilter>
      <thingDefs>
        <li>Synthread</li>
        <li>Hyperweave</li>
        <li>Plasteel</li>
      </thingDefs>
    </apparelStuffFilter>
    <allowedMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Structure_Archist</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Transhumanist</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">HumanPrimacy</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Loyalist</li>
    </allowedMemes>
    <requiredMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Structure_Archist</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Transhumanist</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">HumanPrimacy</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Loyalist</li>
    </requiredMemes>
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(100,100)</li>
        <li>(10000,10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
    <raidsForbidden>true</raidsForbidden>
    <raidCommonalityFromPointsCurve>
      <points>
        <li>(0, 0)</li>
      </points>
    </raidCommonalityFromPointsCurve>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>100</commonality>
        <options>
          <AncientSoldier>1</AncientSoldier>
        </options>
      </li>
    </pawnGroupMakers>
    <messageDefendersAttacking>Merchant hates you now.</messageDefendersAttacking>
  </FactionDef>







