 <ThingDef Name ="Gun_ArchotechChargeRifle"  ParentName="BaseHumanMakeableGun">
        <defName>Gun_ArchotechChargeRifle</defName>
        <label>Archotech charge rifle</label>
        <description>A charge rifle upgraded with the power of Archotech, you cant even imagine how much power each shot has. It also glows with a mysterious force.</description>
        <techLevel>Ultra</techLevel>
        <graphicData>
        <texPath>Things/Weapons/ArchoRifle</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <soundInteract>Interact_ChargeRifle</soundInteract>
